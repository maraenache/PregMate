{
  "name": "recapitulare-geometrie",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Recapitulare Geometrie — curs interactiv static de recapitulare a geometriei",
  "scripts": {
    "prepare-assets": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "npm run prepare-assets && vite",
    "validate": "node scripts/validate-content.mjs",
    "test": "node --test tests/*.test.js",
    "build": "npm run prepare-assets && npm run validate && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "katex": "0.16.47",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "vite": "6.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
